          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/workflows/:resourceIdOrReference",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceIdOrReference",
                "value": "",
                "type": "path",
                "description": "The ID or reference of the resource."
              }
            ]
          },
          "docs": "Fetches a single workflow definition using either its resource ID or reference. Requires the WORKFLOW.VIEW permission."
        },
        {
          "info": {
            "name": "Update a workflow by ID or reference",
