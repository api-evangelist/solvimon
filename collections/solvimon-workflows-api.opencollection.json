            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceIdOrReference",
                "value": "",
                "type": "path",
                "description": "The ID or reference of the resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates workflow fields. Requires the WORKFLOW.UPDATE permission."
        },
        {
          "info": {
            "name": "Deactivate a workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/workflows/:resourceIdOrReference/deactivate",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceIdOrReference",
                "value": "",
                "type": "path",
                "description": "The ID or reference of the resource."
              }
            ]
          },
          "docs": "Transitions a workflow to INACTIVE. so it's stops matching and executing the workflow without archiving it. Requires the WORKFLOW.UPDATE permission."
        },
        {
          "info": {
            "name": "Activate a workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/workflows/:resourceIdOrReference/activate",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceIdOrReference",
                "value": "",
                "type": "path",
                "description": "The ID or reference of the resource."
              }
            ]
          },
          "docs": "Transitions a workflow to ACTIVE so it can be matched by workflow trigger creation. Requires the WORKFLOW.UPDATE permission."
        },
        {
          "info": {
            "name": "Archive a workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/workflows/:resourceIdOrReference/archive",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceIdOrReference",
                "value": "",
                "type": "path",
                "description": "The ID or reference of the resource."
              }
            ]
          },
          "docs": "Transitions a workflow to ARCHIVED. Archived workflows cannot be updated again. Requires the WORKFLOW.UPDATE permission."
        },
