{
  "opencollection": "1.0.0",
  "info": {
    "name": "Configuration alertRules features API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "features",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of all features",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/features",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The amount of records shown in the list"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The parameter by which the response is ordered."
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "The order direction by which the response is ordered."
              }
            ]
          },
          "docs": "Requires the FEATURE.VIEW permission."
        },
        {
          "info": {
            "name": "Create a feature",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/features",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires the FEATURE.CREATE permission."
        },
        {
          "info": {
            "name": "Update or create a feature (upsert)",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://test.api.solvimon.com/v:version/features",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires the FEATURE.CREATE or FEATURE.UPDATE permission."
        },
        {
          "info": {
            "name": "Get a feature by resource ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/features/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              },
              {
                "name": "expand[]",
                "value": "",
                "type": "query",
                "description": "The id fields of the resources that are going to be expanded."
              }
            ]
          },
          "docs": "Requires the FEATURE.VIEW permission."
        },
        {
          "info": {
            "name": "Update a feature",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://test.api.solvimon.com/v:version/features/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires the FEATURE.UPDATE permission."
        },
        {
          "info": {
            "name": "Delete a feature by resource ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://test.api.solvimon.com/v:version/features/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              }
            ]
          },
          "docs": "Requires the FEATURE.DELETE permission."
        }
      ]
    }
  ],
  "bundled": true
}