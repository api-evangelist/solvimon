      "items": [
        {
          "info": {
            "name": "Get a list of events for provided filters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/ingest/meter-data",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "customer_id",
                "value": "",
                "type": "query",
                "description": "The resource id of the customer."
              },
              {
                "name": "reference",
                "value": "",
                "type": "query",
                "description": "The reference of the ingest."
              },
              {
                "name": "meter_id",
                "value": "",
                "type": "query",
                "description": "The resource id of the meter."
              },
              {
                "name": "deleted",
                "value": "",
                "type": "query",
                "description": "Filter the response by deleted field value."
              },
              {
                "name": "processed_details_type",
                "value": "",
                "type": "query",
                "description": "Filter the response by processing_details.type value. Ex.: NOT_MATCHED, DUPLICATE"
              },
              {
                "name": "expand[]",
                "value": "",
                "type": "query",
                "description": "The id fields of the resources that are going to be expanded."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The amount of records shown in the list"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown"
              }
            ]
          },
          "docs": "Requires the METER_DATA.VIEW permission."
        },
        {
          "info": {
