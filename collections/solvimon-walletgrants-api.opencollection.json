{
  "opencollection": "1.0.0",
  "info": {
    "name": "Configuration alertRules walletGrants API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "walletGrants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of all wallet grants",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/wallet-grants",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The amount of records shown in the list."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The parameter by which the response is ordered."
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "The order direction by which the response is ordered."
              },
              {
                "name": "customer_id",
                "value": "",
                "type": "query",
                "description": "Filter wallet grants by customer resource id."
              },
              {
                "name": "wallet_id",
                "value": "",
                "type": "query",
                "description": "Filter wallet grants by wallet resource id."
              }
            ]
          },
          "docs": "Requires the WALLET_GRANT.VIEW permission."
        },
        {
          "info": {
            "name": "Create a wallet grant",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/wallet-grants",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires the WALLET_GRANT.CREATE permission."
        },
        {
          "info": {
            "name": "Get a wallet grant",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/wallet-grants/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              }
            ]
          },
          "docs": "Requires the WALLET_GRANT.VIEW permission."
        }
      ]
    }
  ],
  "bundled": true
}