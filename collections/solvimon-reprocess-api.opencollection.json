{
  "opencollection": "1.0.0",
  "info": {
    "name": "Configuration alertRules reprocess API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "reprocess",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of reprocesses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/reprocess",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "expand[]",
                "value": "",
                "type": "query",
                "description": "The id fields of the resources that are going to be expanded."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "The type of the reprocesses."
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "The status of the reprocesses."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The amount of records shown in the list."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The parameter by which the response is ordered."
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "The order direction by which the response is ordered."
              }
            ]
          },
          "docs": "Requires the REPROCESSING.REPROCESS.VIEW permission."
        },
        {
          "info": {
            "name": "Reprocess meter-data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/reprocess",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires the REPROCESSING.REPROCESS.CREATE permission."
        },
        {
          "info": {
            "name": "Get a reprocess by its ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/reprocess/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              },
              {
                "name": "expand[]",
                "value": "",
                "type": "query",
                "description": "The id fields of the resources that are going to be expanded."
              }
            ]
          },
          "docs": "Requires the REPROCESSING.REPROCESS.VIEW permission."
        }
      ]
    }
  ],
  "bundled": true
}