{
  "opencollection": "1.0.0",
  "info": {
    "name": "Configuration alertRules paymentMethods API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "paymentMethods",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of payment methods",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/payment-methods",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "customer_id",
                "value": "",
                "type": "query",
                "description": "The customer ID."
              },
              {
                "name": "integration_id",
                "value": "",
                "type": "query",
                "description": "The integration ID."
              },
              {
                "name": "integration_payment_method_reference",
                "value": "",
                "type": "query",
                "description": "The integration payment method reference."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The amount of records shown in the list."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The parameter by which the response is ordered."
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "The order direction by which the response is ordered."
              }
            ]
          },
          "docs": "Requires the PAYMENT_METHOD.VIEW permission."
        },
        {
