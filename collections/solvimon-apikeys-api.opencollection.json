            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires the USER.API.VIEW permission."
        },
        {
          "info": {
            "name": "Get an API key by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/api-keys/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
