{
  "opencollection": "1.0.0",
  "info": {
    "name": "Configuration alertRules apiKeys API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "apiKeys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of all API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/api-keys",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "active",
                "value": "",
                "type": "query",
                "description": "The active flag by which the resource will be filtered."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The amount of records shown in the list"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The parameter by which the response is ordered."
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "The order direction by which the response is ordered."
              }
            ]
          },
          "docs": "Requires the USER.API.VIEW permission."
        },
        {
          "info": {
            "name": "Create an API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/api-keys",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires the USER.API.CREATE permission."
        },
        {
          "info": {
            "name": "Search for api keys using a filter",
