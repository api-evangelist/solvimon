{
  "opencollection": "1.0.0",
  "info": {
    "name": "Configuration alertRules documents API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload a document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/documents",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Requires the DOCUMENT.CREATE permission."
        },
        {
          "info": {
            "name": "Get a document by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/documents/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              }
            ]
          },
          "docs": "Requires the DOCUMENT.VIEW permission."
        },
        {
          "info": {
            "name": "Delete a document",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://test.api.solvimon.com/v:version/documents/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              }
            ]
          },
          "docs": "Requires the DOCUMENT.DELETE permission."
        },
        {
          "info": {
            "name": "Download a document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://test.api.solvimon.com/v:version/documents/:resourceId/download",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              }
            ]
          },
          "docs": "Requires the DOCUMENT.DOWNLOAD permission."
        }
      ]
    }
  ],
  "bundled": true
}