            "name": "Get a list of integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/integrations",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The amount of records shown in the list"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The parameter by which the response is ordered."
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "The order direction by which the response is ordered."
              }
            ]
          },
          "docs": "Requires the INTEGRATION.VIEW permission."
        },
