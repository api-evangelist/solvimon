{
  "opencollection": "1.0.0",
  "info": {
    "name": "Configuration alertRules auditRecords API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "auditRecords",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of audit records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/audit-records",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "query",
                "description": "Filter based on user ID"
              },
              {
                "name": "target_entity_id",
                "value": "",
                "type": "query",
                "description": "Filter based on entity resource ID the object belongs to"
              },
              {
                "name": "target_id",
                "value": "",
                "type": "query",
                "description": "Filter based on the resource ID of the object"
              },
              {
                "name": "target_type",
                "value": "",
                "type": "query",
                "description": "Filter based on resource type"
              },
              {
                "name": "created_at",
                "value": "",
                "type": "query",
                "description": "Range filter for the start_at of the audit logs (ISO-8601)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The amount of records shown in the list"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The parameter by which the response is ordered."
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "The order direction by which the response is ordered."
              }
            ]
          },
          "docs": "Requires the AUDIT_RECORD.VIEW permission."
        },
        {
          "info": {
            "name": "Get an invoice by resource ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://test.api.solvimon.com/v:version/audit-records/:resourceId",
            "headers": [
              {
                "name": "X-API-KEY",
                "value": ""
              },
              {
                "name": "x-platform-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "version"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "path",
                "description": "The ID of the resource to be requested."
              }
            ]
          },
          "docs": "Requires the AUDIT_RECORD.VIEW permission."
        }
      ]
    }
  ],
  "bundled": true
}