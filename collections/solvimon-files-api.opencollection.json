                "description": "The amount of records shown in the list"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page which is going to be shown"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "The status by which the resource will be filtered."
              }
            ]
